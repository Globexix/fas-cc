use linux "sys/linux.fas"

fn remove_extension(file addr) addr {
    i i32 = 0
    while file[u8, i] != 0 {
        if file[u8, i] == '.' { file[u8, i] = 0; return file }
        i += 1
    }
    return file
}

fn main(argc i32, argv addr) i32 {
    if argc < 2 { return -1 }

    output arr[256, u8] = {}
    i i32 = 0
    while argv[addr, 1][u8, i] != 0 && i < 255 {
        output[i] = argv[addr, 1][u8, i]
        i += 1
    }

    remove_extension(&output)

    gcc addr = c"/usr/bin/gcc"
    gcc_args arr[5, addr] = {
        c"gcc",
        argv[addr, 1],
        c"-o",
        &output,
        null
    }
    envp arr[2, addr] = { c"PATH=/usr/bin:/bin", null }

    pid i64 = sys_fork()
    if pid < 0 { return -1 }

    if pid == 0 {
        sys_execve(gcc, &gcc_args, &envp)
        // execve failed if it reaches here
        sys_exit(127)
    }

    status i32 = 0
    r i64 = sys_wait4(trunc[i32](pid), &status)

    if r < 0 { return -1 }

    if exited_normally(status) {
        return exit_code(status)
    }

    return -1
}
